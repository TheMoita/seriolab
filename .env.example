# TMDB API Configuration (The Movie Database)
# Regista-te em https://www.themoviedb.org/ e cria uma chave em Settings -> API.
# Podes utilizar tanto uma v3 API Key (32 carateres) como um v4 Read Access Token.
TMDB_API_KEY=your_tmdb_api_key_here
TMDB_BASE_URL=https://api.themoviedb.org/3
TMDB_IMAGE_BASE_URL=https://image.tmdb.org/t/p/w500
TMDB_LANGUAGE=pt-PT
